{"sections":{"main":{"type":"main-page","disabled":true,"settings":{"subheading":"","show_title":true,"show_content":true,"align_text":"text-left","width":"wrapper","padding_top":50,"padding_bottom":50}},"section_double_Ggqmq9":{"type":"section-double","blocks":{"subheading_hkJXEt":{"type":"subheading","settings":{"subheading":"2ピースボールの常識を覆す『 PANTHER 』","padding_bottom":12}},"heading_9aEUdz":{"type":"heading","settings":{"title":"100切りを力強くサポートする最適なボール","padding_bottom":12}},"text_kfxydX":{"type":"text","settings":{"text":"<p>Trust Panther が採用する<strong>プレミアムな柔らかいウレタンカバー<\/strong>。カバーの柔らかさにより、ゴルフクラブの溝がゴルフボールに食い込むことで強い摩擦を生み出し、ボールをコントロールする楽しみに繋がっていきます。<\/p><p><strong>『プレーを向上させたい』100切りを目指している方、ハンディが多いプレーヤー、シニアゴルファー、ジュニアゴルファーにぜひ使って欲しいボールです！<\/strong><\/p><ul><li>驚きの飛距離と、心地よい打感。<\/li><li>飛距離を大きく伸ばす、曲がらない強弾道。<\/li><li>グリーン周りを強化するプレミアムウレタンカバー。<\/li><\/ul>","padding_bottom":12}},"buttons_aw3cJw":{"type":"buttons","disabled":true,"settings":{"button_text":"Learn more","button_url":"","button_type":"btn--primary","button_size":"","button_style":"btn--solid","show_arrow":false,"padding_bottom":16}}},"block_order":["subheading_hkJXEt","heading_9aEUdz","text_kfxydX","buttons_aw3cJw"],"name":"Image with text","settings":{"image_1":"shopify:\/\/shop_images\/14-2_b83ae7c8-822d-45d4-b24b-24dfeb7c215b.jpg","image_width":"one-half","text_alignment":"text-left","layout":"","width":"wrapper--full","height":"screen-height-two-thirds","mobile_height":"screen-height-one-half--mobile","reverse_blocks":false,"padding_top":0,"padding_bottom":0}},"section_collection_BdXw9t":{"type":"section-collection","name":"Featured collection","settings":{"featured_collection":"panther","heading":"","description":"<h4><strong>今すぐ手に入れる<\/strong><\/h4>","layout":"center","link_text":"","link_url":"","button_type":"btn--primary","button_size":"","button_style":"btn--solid","show_arrow":false,"layout_desktop":"grid","grid":4,"rows":3,"width":"wrapper","layout_mobile":"2","padding_top":28,"padding_bottom":29}},"s
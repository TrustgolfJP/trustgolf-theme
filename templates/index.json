 <!-- 封面層：避免初始黑畫面 -->\n    <div class=\"video-cover\" id=\"videoCover\">\n      <button class=\"play-btn\" id=\"playButton\" aria-label=\"播放影片\"><\/button>\n    <\/div>\n\n    <!-- 播放 \/ 暫停 提示圖示 -->\n    <div class=\"feedback-icon\" id=\"feedbackIcon\"><\/div>\n  <\/div>\n<\/div>\n\n<style>\n.ig-video-wrap {\n  max-width: 420px;\n  margin: 0 auto;\n  position: relative;\n}\n\n.video-container {\n  position: relative;\n}\n\n.ig-video {\n  width: 100%;\n  aspect-ratio: 9 \/ 14;\n  object-fit: cover;\n  border-radius: 12px;\n  display: block;\n  background: #000;\n  cursor: pointer;\n}\n\n\/* 封面層 *\/\n.video-cover {\n  position: absolute;\n  inset: 0;\n  border-radius: 12px;\n  overflow: hidden;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  background: center\/cover no-repeat url('https:\/\/cdn.shopify.com\/s\/files\/1\/0527\/9930\/7965\/files\/Bison-V-Power.jpg?v=1758952844');\n}\n\n\/* 播放按鈕 *\/\n.play-btn {\n  width: 80px;\n  height: 80px;\n  background: rgba(0,0,0,0.6);\n  border-radius: 50%;\n  border: none;\n  cursor: pointer;\n  z-index: 2;\n  position: relative;\n}\n\n.play-btn::before {\n  content: '';\n  position: absolute;\n  top: 50%;\n  left: 50%;\n  transform: translate(-40%, -50%);\n  width: 0;\n  height: 0;\n  border-left: 28px solid #fff;\n  border-top: 18px solid transparent;\n  border-bottom: 18px solid transparent;\n}\n\n.play-btn:hover { background: rgba(0,0,0,0.8); }\n.play-btn:focus { outline: none; }\n\n\/* 播放 \/ 暫停 提示圖示 *\/\n.feedback-icon {\n  position: absolute;\n  top: 50%;\n  left: 50%;\n  transform: translate(-50%, -50%);\n  font-size: 72px;\n  color: rgba(255,255,255,0.9);\n  opacity: 0;\n  pointer-events: none;\n  z-index: 5;\n  transition: opacity 0.3s ease;\n}\n.feedback-icon.show { opacity: 1; }\n<\/style>\n\n<script>\ndocument.addEventListener(\"DOMContentLoaded\", () => {\n  const video = document.getElementById(\"igVideo\");\n  const cover = document.getElementById(\"videoCover\");\n  const playButton = document.getElementById(\"playButton\");\n  const feedbackIcon = document.getElementById(\"feedbackIcon\");\n\n  \/\/ 確保初始顯示封面\n  cover.style.display = \"flex\";\n\n  \/\/ 點擊播放按鈕 → 開始播放並移除封面\n  playButton.addEventListener(\"click\", () => {\n    cover.style.display = \"none\";\n    video.play();\n  });\n\n  \/\/ 點影片 → 播放 \/ 暫停\n  video.addEventListener(\"click\", () => {\n    if (video.paused) {\n      video.play();\n      showFeedback(\"▶️\");\n    } else {\n      video.pause();\n      showFeedback(\"⏸\");\n    }\n  });\n\n  \/\/ 播放開始後確保封面隱藏\n  video.addEventListener(\"playing\", () => {\n    cover.style.display = \"none\";\n  });\n\n  \/\/ 播放結束後 → 回到開頭並重新顯示封面\n  video.addEventListener(\"ended\", () => {\n    video.currentTime = 0;\n    video.pause();\n    cover.style.display = \"flex\";\n  });\n\n  \/\/ 顯示播放 \/ 暫停 提示圖示\n  function showFeedback(symbol) {\n    feedbackIcon.textContent = symbol;\n    feedbackIcon.classList.add(\"show\");\n    setTimeout(() => feedbackIcon.classList.remove(\"show\"), 800);\n  }\n});\n<\/script>","width":"wrapper","color_scheme":"","padding_top":0,"padding_bottom":0}},"tabs":{"type":"section-tab-collections","blocks":{"tabs-0":{"type":"collection","settings":{"title":"","featured_collection":"bison-power","show_image":false,"align_with_product_images":false,"overlay_type":"disabled","description":"","color":"#2f2f2f","link_text":"","link":"","button_type":"btn--primary","button_size":"","button_style":"btn--outline","show_arrow":false}}},"block_order":["tabs-0"],"settings":{"show_product_count":false,"title":"","heading_font_size":"heading-medium","text":"","text_font_size":"body-medium","layout":"stacked","layout_desktop":"grid","product_limit":6,"grid":4,"rows":3,"layout_mobile":"2","color_scheme":"","padding_top":12,"padding_bottom":12,"heading_tag":"automatic"}},"section_divider_eXBmdM":{"type":"section-divider","settings":{"show_line":true,"width":"wrapper--full","color_scheme":"","padding_top":50,"padding_bottom":50}},"section_rich
<span style=\"font-size:18px;\">吹け上がらず風に負けない強弾道。Trust のウレタンカバーに最適な空力計算に基づく332ディンプル。<\/span><\/p>\n    <\/li>\n<\/ul>\n<p style=\"margin-left:0px;\">&nbsp;<\/p>\n<p style=\"margin-left:0px;\"><span style=\"font-size:18px;\"><i><strong>Trust Golfの強みは、設計・開発・製造を充実させプレミアムな価値を高め、販売に至るまですべて自分たちの手でダイレクトに行い、よりリーズナブルに届けることです。成長と楽しさをもたらすこの優れたボールを、すべてのゴルファーへ届けたい。<\/strong><\/i><\/span><\/p>"}}},"block_order":["code_D87q6j"],"settings":{"default_open":true,"title":"ダイレクトブランド - 魅力的な価格のプレミアムツアーボール","heading_font_size":"heading-small","show_icon":true,"icon_name":"icon-notes","icon_image":"shopify:\/\/shop_images\/Trust_G.jpg","icon_size":80,"width":"wrapper","color_scheme":"","icon_color":"#545454","padding_top":20,"padding_bottom":20}},"section_press_logos_67MDdb":{"type":"section-press-logos","blocks":{"logo_item_header_ym347x":{"type":"logo-item-header","settings":{"logo":"shopify:\/\/shop_images\/imageedit_21_4384400687.jpg","logo_width":150,"link":"","text":"","heading_font_size":"heading-small"}},"logo_item_header_zEPp4a":{"type":"logo-item-header","settings":{"logo":"shopify:\/\/shop_images\/golf-monthly-logo.jpg","logo_width":150,"link":"","text":"","heading_font_size":"heading-small"}},"logo_item_header_AxQ4jp":{"type":"logo-item-header","settings":{"logo":"shopify:\/\/shop_images\/Screenshot_2022-12-28_at_10.04.06.jpg","logo_width":150,"link":"","text":"","heading_font_size":"heading-small"}},"logo_item_header_DxmQ9i":{"type":"logo-item-header","settings":{"logo":"shopify:\/\/shop_images\/Golf-Digest-e1476470127379.jpg","logo_width":150,"link":"","text":"","heading_font_size":"heading-small"}},"logo_item_header_3AeFVj":{"type":"logo-item-header","settings":{"logo":"shopify:\/\/shop_images\/channels4_banner_a50553d3-fdc4-4728-ad0a-437e8f069ce0.jpg","logo_width":150,"link":"","text":"","heading_font_size":"heading-small"}}},"block_order":["logo_item_header_ym347x","logo_item_header_zEPp4a","logo_item_header_AxQ4jp","logo_item_header_DxmQ9i","logo_item_header_3AeFVj"],"sett